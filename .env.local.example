# Copy to .env.local (never commit .env.local)

# Supabase — from Project Settings → API (https://supabase.com/dashboard)
# Use the service role key only on the server (webhook); never NEXT_PUBLIC_ or client bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — from https://console.twilio.com (required for signature verification in production)
TWILIO_AUTH_TOKEN=

# If Twilio signature checks fail on Vercel, set to your public origin (no trailing slash).
# Example: https://maverick-xxx.vercel.app
# TWILIO_WEBHOOK_BASE_URL=

# Local only: set to 1 to skip Twilio signature validation (never in production)
# SKIP_TWILIO_SIGNATURE=1

# OpenAI — from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
